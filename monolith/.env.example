# AIVIN environment. Generate a real .env with: make init-env
# Never commit .env.

# --- Django ---
SECRET_KEY=
FIELD_ENCRYPTION_KEY=
DEBUG=false
ALLOWED_HOSTS=aivin.sc2platform.biz.id,ainurse.sc2platform.biz.id,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://aivin.sc2platform.biz.id,https://ainurse.sc2platform.biz.id
TIME_ZONE=Asia/Jakarta
LOG_LEVEL=INFO
KIOSK_API_RATE=60/m

# --- BLE gateway (OMRON devices) ---
GATEWAY_TOKEN=

# --- PostgreSQL ---
POSTGRES_DB=aivin
POSTGRES_USER=aivin
POSTGRES_PASSWORD=

# --- Host port (bound to 127.0.0.1; point Cloudflare Tunnel at http://localhost:<port>) ---
AIVIN_PORT=8010

# The OpenAI API key is not configured here: set it in Admin → System settings.
