# AIVIN environment. Generate a real .env with: make init-env
# Never commit .env.

# --- Django ---
SECRET_KEY=
FIELD_ENCRYPTION_KEY=
DEBUG=false
ALLOWED_HOSTS=nurse.avantecmgt.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://nurse.avantecmgt.app
TIME_ZONE=Asia/Jakarta
# Public HTTPS address; the ticket QR code links here so patients can open it on their phone.
PUBLIC_BASE_URL=https://nurse.avantecmgt.app
LOG_LEVEL=INFO
KIOSK_API_RATE=60/m

# --- BLE gateway (OMRON devices) ---
GATEWAY_TOKEN=

# --- PostgreSQL ---
POSTGRES_DB=aivin
POSTGRES_USER=aivin
POSTGRES_PASSWORD=

# --- Host port (bound to 127.0.0.1; point Cloudflare Tunnel at http://localhost:<port>) ---
# Requests on the public host are always redirected to HTTPS; localhost may use HTTP.
SECURE_SSL_REDIRECT=false
AIVIN_PORT=8010

# The OpenAI API key is not configured here: set it in Admin → System settings.
